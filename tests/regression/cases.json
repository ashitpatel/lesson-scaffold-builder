{
  "_about": "Regression cases for python3 -m lsb.regress. Each source is an original test chapter in tests/fixtures/. 'forbidden' lists planted traps and region-specific names that must not survive into the final sequence; 'required' lists terms a faithful sequence must keep. See lsb/regress.py.",
  "cases": [
    {
      "name": "hydrology",
      "source": "tests/fixtures/hydrology-source.md",
      "ref": "Chapter 4 - Basic Hydrology Framework",
      "expect": {"status": "pass", "max_units": 4, "required": ["rain"]}
    },
    {
      "name": "ecosystems",
      "source": "tests/fixtures/ecosystems-source.md",
      "ref": "Unit 5 - Ecosystems: Energy Flow and Food Webs",
      "expect": {"status": "pass", "max_units": 4, "forbidden": ["tablets", "jars"], "required": ["quadrat", "food web"],
                 "min_source_flags": 4, "stage_may_not_apply": ["participatory_budgeting"]}
    },
    {
