{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lesson-scaffold-builder/schemas/mls-dag.schema.json",
  "title": "MLS_DAG_Sequence",
  "description": "A decomposed source document: one macro objective and a DAG of Micro-Lesson Scaffold (MLS) units. Base shape from the LSB requirements (Part 2, section 5). Fields marked LSB-EXT are additions the deterministic critic checks need; they are optional here so the spec's own payloads still parse, and lsb.validate reports their absence as a failed check.",
  "type": "object",
  "required": ["macro_objective", "global_context", "mls_units"],
  "properties": {
    "macro_objective": { "type": "string", "minLength": 1 },
    "global_context": {
      "type": "object",
      "required": ["grade_band", "time_block_minutes", "resource_intensity_score"],
      "properties": {
        "grade_band": { "type": "string", "enum": ["Primary", "Middle", "High"] },
        "time_block_minutes": { "type": "integer", "minimum": 5, "maximum": 120 },
        "resource_intensity_score": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "mls_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mls_id", "title", "dependencies", "tasks"],
        "properties": {
          "mls_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "macro_alignment": {
            "description": "LSB-EXT. How this unit advances macro_objective, in one sentence (critic check: Macro Alignment).",
            "type": "string",
            "minLength": 1
          },
          "duration_weeks": {
            "description": "LSB-EXT. Planned run length of this unit in weeks (critic check: Execution Window, 2 to 4).",
            "type": "integer",
            "minimum": 1
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["step", "role", "action"],
              "properties": {
                "step": { "type": "integer", "minimum": 1 },
                "role": { "type": "string", "enum": ["Lead_Educator", "Community_Volunteer", "Peer_Facilitator"] },
                "action": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
